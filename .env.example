FILIGREE_DEMO=1
ANALYZER=replay            # replay | live | mock (demo mode)
ANALYZER_PROVIDER=         # anthropic | groq | gemini | openai (auto-detected from key prefix if empty)
ANALYZER_MODEL=            # optional override; defaults: claude-haiku-4-5 / openai/gpt-oss-120b / gemini-2.5-flash
ANALYZER_API_KEY=          # or ANTHROPIC_API_KEY / GROQ_API_KEY / GEMINI_API_KEY
FILIGREE_CORS=http://localhost:5173,http://127.0.0.1:5173   # allowed UI origins (comma separated)
FILIGREE_DB=filigree.db
